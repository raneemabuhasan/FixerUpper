{
  "name": "resolve",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:all": "concurrently -n web,server -c cyan,magenta \"npm:dev\" \"npm:dev:server\"",
    "build": "tsc --noEmit && tsc -p server && vite build",
    "test": "node --experimental-strip-types --test shared/workflow.test.ts",
    "test:server": "vitest run --dir server",
    "typecheck:server": "tsc -p server",
    "db:reset": "tsx server/src/db/reset.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "express": "^5.3.0",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.11",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.7",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "vitest": "^4.1.12"
  }
}
